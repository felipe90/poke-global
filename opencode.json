{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "set -a && source .env && set +a && exec npx -y figma-developer-mcp"
      ],
      "cwd": ".",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--allowed-hosts",
        "localhost,127.0.0.1"
      ],
      "cwd": ".",
      "enabled": true
    }
  }
}
